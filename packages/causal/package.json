{
  "name": "@kanaries/causal",
  "version": "0.3.0",
  "description": "Causal discovery and causal inference toolkit for JavaScript and TypeScript (Node.js & browser): PC, FCI, GES, ExactSearch, GRaSP, CD-NOD, GIN, CAM-UV, RCD, ANM, DAG/ADMG identification, backdoor adjustment, falsification, and AI-agent diagnostics.",
  "keywords": [
    "causal-discovery",
    "causal-inference",
    "causality",
    "causal-graph",
    "dag",
    "admg",
    "do-calculus",
    "backdoor",
    "pc-algorithm",
    "ges",
    "fci",
    "causal-learn",
    "dowhy",
    "econometrics",
    "statistics",
    "typescript",
    "browser",
    "ai-agent"
  ],
  "homepage": "https://github.com/Kanaries/causal-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kanaries/causal-js.git",
    "directory": "packages/causal"
  },
  "bugs": {
    "url": "https://github.com/Kanaries/causal-js/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      },
      "require": {
        "types": "./dist/node/index.d.cts",
        "default": "./dist/node/index.cjs"
      }
    },
    "./web": {
      "import": {
        "types": "./dist/web/index.d.ts",
        "default": "./dist/web/index.js"
      },
      "require": {
        "types": "./dist/web/index.d.cts",
        "default": "./dist/web/index.cjs"
      }
    },
    "./node/workers/pc-worker-entry": {
      "import": {
        "types": "./dist/node/workers/pc-worker-entry.d.ts",
        "default": "./dist/node/workers/pc-worker-entry.js"
      },
      "require": {
        "types": "./dist/node/workers/pc-worker-entry.d.cts",
        "default": "./dist/node/workers/pc-worker-entry.cjs"
      }
    },
    "./node/workers/pc-worker-runtime": {
      "import": {
        "types": "./dist/node/workers/pc-worker-runtime.d.ts",
        "default": "./dist/node/workers/pc-worker-runtime.js"
      },
      "require": {
        "types": "./dist/node/workers/pc-worker-runtime.d.cts",
        "default": "./dist/node/workers/pc-worker-runtime.cjs"
      }
    },
    "./web/workers/pc-worker-entry": {
      "import": {
        "types": "./dist/web/workers/pc-worker-entry.d.ts",
        "default": "./dist/web/workers/pc-worker-entry.js"
      },
      "require": {
        "types": "./dist/web/workers/pc-worker-entry.d.cts",
        "default": "./dist/web/workers/pc-worker-entry.cjs"
      }
    },
    "./web/workers/pc-worker-runtime": {
      "import": {
        "types": "./dist/web/workers/pc-worker-runtime.d.ts",
        "default": "./dist/web/workers/pc-worker-runtime.js"
      },
      "require": {
        "types": "./dist/web/workers/pc-worker-runtime.d.cts",
        "default": "./dist/web/workers/pc-worker-runtime.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "examples/known-effect.mjs"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
